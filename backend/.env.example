# Required for admin authentication. Do NOT put these values in the frontend.
TRIPPLANKARO_ADMIN_USERNAME=admin
TRIPPLANKARO_ADMIN_PASSWORD=replace-with-a-long-random-password
TRIPPLANKARO_SESSION_SECRET=replace-with-a-long-random-secret
# Optional: session lifetime in seconds (default 8 hours)
TRIPPLANKARO_SESSION_TTL=28800
# Optional when frontend and API are on different production origins:
# TRIPPLANKARO_CORS_ORIGINS=https://www.tripplankaro.com
